NODE_ENV=production
HOST=127.0.0.1
PORT=4000
SERVE_WEB=1
# Debe coincidir con el dominio HTTPS real del proxy.
CORS_ORIGIN=https://rubroos.example.com
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_48_CARACTERES
DATABASE_PATH=/var/lib/rubroos/rubroos.db
BACKUP_DIR=/var/lib/rubroos/backups
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28
OWNER_EMAIL=CAMBIAR_CORREO_DEL_DUENO
OWNER_SEED_PASSWORD=CAMBIAR_CLAVE_LARGA_UNICA
PUBLIC_REGISTRATION=0
# Un solo proxy local entre internet y Node.
TRUST_PROXY=loopback
# Claude ya está soportado. Descomenta estas tres líneas y coloca los valores
# únicamente en el servidor, nunca en GitHub ni dentro del frontend.
# AI_PROVIDER=anthropic
# AI_API_KEY=tu_clave_privada_de_anthropic
# AI_MODEL=claude-haiku-4-5-20251001
AI_FAKE_PROVIDER=0
# WhatsApp Cloud API: configura estos valores cuando Meta y HTTPS estén listos.
# WHATSAPP_ACCESS_TOKEN=token_de_sistema_de_meta
# WHATSAPP_PHONE_NUMBER_ID=id_del_numero_de_whatsapp
# WHATSAPP_APP_SECRET=secreto_de_la_app_meta
# WHATSAPP_VERIFY_TOKEN=texto_aleatorio_que_defines_tu
WHATSAPP_FAKE_TRANSPORT=0
