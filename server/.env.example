# Copia este archivo a .env y completa los valores reales.
# .env nunca debe subirse al repositorio (ya está en .gitignore).

NODE_ENV=development
PORT=4000

# Obligatorio. Genera uno único y largo, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cuenta del dueño del SaaS. Solo se usan la primera vez que arranca el
# servidor con una base de datos vacía (para crear esa cuenta) — después,
# ya no se consultan.
OWNER_EMAIL=
OWNER_SEED_PASSWORD=

# Ruta al archivo SQLite. Si se deja vacío, usa server/data/rubroos.db
DATABASE_PATH=

# URL pública del frontend (usada para enlaces/CORS en producción)
FRONTEND_URL=http://localhost:5173

# Orígenes permitidos por CORS, separados por coma. En desarrollo:
CORS_ORIGIN=http://localhost:5173

# Proveedor de IA para el asistente. "openai" (default) usa la API de
# OpenAI; "anthropic" (o "claude") usa la API de Mensajes de Anthropic.
# Cualquiera de los dos requiere su propia AI_API_KEY (ver abajo) — no son
# intercambiables con la misma clave.
AI_PROVIDER=openai

# Clave de la API del proveedor elegido arriba (sk-... de OpenAI, o
# sk-ant-... de Anthropic/console.anthropic.com) para el asistente de IA.
# Nunca subas el valor real a ningún archivo versionado — esta línea debe
# quedar siempre vacía aquí; el valor real solo vive en tu server/.env local
# (no versionado).
AI_API_KEY=

# Modelo a usar, según AI_PROVIDER. Si se deja vacío, el backend usa:
#   openai     -> gpt-4o-mini (rápido y económico, buen soporte de function calling)
#   anthropic  -> claude-haiku-4-5-20251001 (rápido y económico, buen soporte de tool use)
# Cambialo aquí si quieres otro modelo, por ejemplo gpt-4o o claude-sonnet-5
# para respuestas más elaboradas.
AI_MODEL=

# Preparado para la futura integración de WhatsApp Cloud API (no usado todavía)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
