# Copia este archivo a .env y completa los valores reales.
# .env nunca debe subirse al repositorio (ya está en .gitignore).

NODE_ENV=development
PORT=4000

# Obligatorio. Genera uno único y largo, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cuenta del dueño del SaaS. Solo se usan la primera vez que arranca el
# servidor con una base de datos vacía (para crear esa cuenta) — después,
# ya no se consultan.
OWNER_EMAIL=
OWNER_SEED_PASSWORD=

# Ruta al archivo SQLite. Si se deja vacío, usa server/data/rubroos.db
DATABASE_PATH=

# URL pública del frontend (usada para enlaces/CORS en producción)
FRONTEND_URL=http://localhost:5173

# Orígenes permitidos por CORS, separados por coma. En desarrollo:
CORS_ORIGIN=http://localhost:5173

# Proveedor de IA para el asistente. "openai" (default) usa la API de
# OpenAI; "anthropic" (o "claude") usa la API de Mensajes de Anthropic;
# "google" (o "gemini") usa la API de Google AI Studio; "groq" usa la API de
# Groq (compatible con el formato de OpenAI, capa gratuita mucho más
# generosa que la de Google AI Studio). Cada uno requiere su propia
# AI_API_KEY (ver abajo) — no son intercambiables con la misma clave.
AI_PROVIDER=openai

# Clave de la API del proveedor elegido arriba (sk-... de OpenAI,
# sk-ant-... de Anthropic/console.anthropic.com, la clave de
# aistudio.google.com para Google, o gsk_... de console.groq.com para Groq)
# para el asistente de IA. Nunca subas el valor real a ningún archivo
# versionado — esta línea debe quedar siempre vacía aquí; el valor real solo
# vive en tu server/.env local (no versionado).
AI_API_KEY=

# Modelo a usar, según AI_PROVIDER. Si se deja vacío, el backend usa:
#   openai     -> gpt-4o-mini (rápido y económico, buen soporte de function calling)
#   anthropic  -> claude-haiku-4-5-20251001 (rápido y económico, buen soporte de tool use)
#   google     -> gemini-3.6-flash (rápido y económico, buen soporte de function calling)
#   groq       -> openai/gpt-oss-20b (rápido, buen soporte de tool calling)
# Cambialo aquí si quieres otro modelo, por ejemplo gpt-4o, claude-sonnet-5
# o gemini-3.6-pro para respuestas más elaboradas.
AI_MODEL=

# Integración de WhatsApp Cloud API (canal adicional sobre el mismo
# asistente — ver server/src/whatsapp). Los 5 valores salen del panel de
# Meta for Developers (developers.facebook.com) al configurar tu app y tu
# número de WhatsApp Business. Nunca subas valores reales aquí ni en
# ningún archivo versionado — esta línea debe quedar vacía; los valores
# reales solo viven en tu server/.env local (no versionado).
#
# WHATSAPP_VERIFY_TOKEN: cualquier string que tú inventes — se lo das a Meta
#   al configurar el Callback URL del webhook, y Meta te lo devuelve en la
#   verificación (GET /api/whatsapp/webhook) para confirmar que eres tú.
# WHATSAPP_ACCESS_TOKEN: token de acceso de la app/número de WhatsApp Business.
# WHATSAPP_PHONE_NUMBER_ID: id del número de WhatsApp Business (no es el
#   número de teléfono en sí).
# WHATSAPP_BUSINESS_ACCOUNT_ID: id de la cuenta de WhatsApp Business.
# WHATSAPP_APP_SECRET: secreto de la app de Meta, usado para verificar la
#   firma X-Hub-Signature-256 de cada mensaje entrante — sin esto, el
#   webhook rechaza todo con 403 (por diseño: nunca procesa nada sin firma).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
